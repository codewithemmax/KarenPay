# Names only. Never put real values in this file. Real values go in a local untracked .env and the Render dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
# GroqCloud fallback API key (from https://console.groq.com/keys) to bypass Gemini 503 overload spikes
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional alternative provider: xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
RP_ID=localhost
RP_NAME=KarenPay
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=
MANDATE_TTL_SECONDS=120
MAX_AMOUNT_MINOR=10000
MAX_BATCH_MINOR=30000
ALLOWED_CURRENCIES=USD
RESEND_API_KEY=
RESEND_FROM_EMAIL=KarenPay <onboarding@resend.dev>
